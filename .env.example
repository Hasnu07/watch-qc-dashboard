# PostgreSQL database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/qc_dashboard"

# GreenAPI credentials (from app.green-api.com)
GREENAPI_INSTANCE_ID="your_instance_id"
GREENAPI_API_TOKEN="your_api_token"

# Anthropic Claude API key (from console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Serper Google image search (https://serper.dev — 2,500 free queries)
SERPER_API_KEY=""

# Base URL of this app (used for webhook registration, e.g. https://your-app.onrender.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
