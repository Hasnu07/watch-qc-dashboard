generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Department {
  LOGISTICS
  ACCOUNTING
  SALES
}

enum TaskDepartment {
  ACCOUNTING
  SALES
  LOGISTICS
}

enum TaskType {
  ACCOUNTING_MARK_PAYMENT
  SALES_SET_PRICE
  SALES_UPLOAD_DRIVE
  SALES_UPLOAD_STOCK_GROUP
  SALES_UPDATE_B2B
  SALES_GET_B2C_PRICES
  LOGISTICS_SET_LOCATION
  LOGISTICS_UPDATE_COST
  LOGISTICS_ACCESSORIES_BOX
  LOGISTICS_ACCESSORIES_PAPERS
  LOGISTICS_ACCESSORIES_EXTRA_LINKS
  LOGISTICS_ACCESSORIES_WARRANTY_CARD
  LOGISTICS_ACCESSORIES_HANG_TAG
}

enum WatchStage {
  LOGISTICS
  ACCOUNTING
  SALES
}

enum PaymentStatus {
  NOT_PAID
  PARTIAL
  PAID
}

enum LocationStatus {
  INCOMING
  IN_TRANSIT
  IN_STOCK
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CRYPTO
}

model Watch {
  id             Int        @id @default(autoincrement())
  brand          String?
  model          String?
  ref_no         String?
  serial_no      String?
  stock_no       String?
  watch_date     String?
  bought_from    String?
  currency       String     @default("USD")
  purchase_price Decimal?   @db.Decimal(12, 2)
  convert_rate   Decimal?   @db.Decimal(12, 6)
  case_material  String?
  dial_colour    String?
  bracelet       String?
  stock_status   String     @default("STOCK")
  origin         String?
  name           String
  image_url      String?
  website_price  Decimal    @db.Decimal(12, 2)
  b2b_price      Decimal    @db.Decimal(12, 2)
  stage          WatchStage @default(LOGISTICS)
  is_sold        Boolean    @default(false)
  payment_status          PaymentStatus  @default(NOT_PAID)
  total_amount            Float?
  location_status         LocationStatus @default(INCOMING)
  location_from           String?
  location_to             String?
  transit_pickup_date     DateTime?
  transit_carrier         String?
  transit_tracking_number String?
  received_date           DateTime?
  created_at              DateTime   @default(now())
  payments                WatchPayment[]
  logistics_cost          Float?
  logistics_cost_currency String?
  watch_tasks             WatchTask[]
}

model WatchPayment {
  id             Int           @id @default(autoincrement())
  watch_id       Int
  watch          Watch         @relation(fields: [watch_id], references: [id], onDelete: Cascade)
  amount         Float
  currency       String        @default("USD")
  payment_method PaymentMethod @default(CASH)
  payment_date   DateTime      @default(now())
  notes          String?
  created_at     DateTime      @default(now())
}

model WatchTask {
  id           Int            @id @default(autoincrement())
  watch_id     Int
  watch        Watch          @relation(fields: [watch_id], references: [id], onDelete: Cascade)
  department   TaskDepartment
  task_type    TaskType
  is_completed Boolean        @default(false)
  completed_at DateTime?
  completed_by String?
  assigned_to  String?
  is_locked    Boolean        @default(false)
  metadata     Json?
  created_at   DateTime       @default(now())
}

model TeamMember {
  id               Int        @id @default(autoincrement())
  name             String
  whatsapp_number  String     @unique
  department       Department @default(LOGISTICS)
  created_at       DateTime   @default(now())
  tasks_assigned_to Task[]    @relation("AssignedTo")
  tasks_assigned_by Task[]    @relation("AssignedBy")
}

model Task {
  id                        Int         @id @default(autoincrement())
  team_member_id            Int
  team_member               TeamMember  @relation("AssignedTo", fields: [team_member_id], references: [id], onDelete: Cascade)
  assigned_by_id            Int?
  assigned_by               TeamMember? @relation("AssignedBy", fields: [assigned_by_id], references: [id], onDelete: SetNull)
  message_text              String
  date                      String
  estimated_minutes         Int?
  is_completed              Boolean     @default(false)
  completed_at              DateTime?
  reminder_interval_minutes Int?
  created_at                DateTime    @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
