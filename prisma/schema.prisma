generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Department {
  LOGISTICS
  ACCOUNTING
  SALES
}

enum TaskDepartment {
  ACCOUNTING
  SALES
  LOGISTICS
}


enum WatchStage {
  LOGISTICS
  ACCOUNTING
  SALES
}

enum PaymentStatus {
  NOT_PAID
  PARTIAL
  PAID
}

enum LocationStatus {
  INCOMING
  IN_TRANSIT
  IN_STOCK
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CRYPTO
}

enum MemberRole {
  MEMBER
  MASTER
}

model Watch {
  id             Int        @id @default(autoincrement())
  brand          String?
  model          String?
  ref_no         String?
  serial_no      String?
  stock_no       String?
  watch_date     String?
  bought_from    String?
  sold_to        String?
  currency       String     @default("USD")
  purchase_price Decimal?   @db.Decimal(12, 2)
  convert_rate   Decimal?   @db.Decimal(12, 6)
  case_material  String?
  dial_colour    String?
  bracelet       String?
  stock_status   String     @default("STOCK")
  origin         String?
  name           String
  image_url      String?
  website_price  Decimal    @db.Decimal(12, 2)
  b2b_price      Decimal    @db.Decimal(12, 2)
  stage          WatchStage @default(LOGISTICS)
  is_sold        Boolean    @default(false)
  watch_type     String     @default("BUY_SELL")
  payment_status          PaymentStatus  @default(NOT_PAID)
  total_amount            Float?
  location_status         LocationStatus @default(INCOMING)
  location_from           String?
  location_to             String?
  transit_pickup_date     DateTime?
  transit_carrier         String?
  transit_tracking_number String?
  received_date           DateTime?
  created_at              DateTime   @default(now())
  updated_at              DateTime   @default(now()) @updatedAt
  linked_buy_watch_id     Int?
  linked_buy_watch        Watch?     @relation("BuySellLink", fields: [linked_buy_watch_id], references: [id], onDelete: SetNull)
  linked_sell_watches     Watch[]    @relation("BuySellLink")
  fob_url                 String?
  payments                WatchPayment[]
  logistics_cost          Float?
  logistics_cost_currency String?
  watch_tasks             WatchTask[]
  activities              WatchActivity[]
}

model WatchActivity {
  id         Int      @id @default(autoincrement())
  watch_id   Int
  watch      Watch    @relation(fields: [watch_id], references: [id], onDelete: Cascade)
  action     String
  detail     String?
  actor      String?
  created_at DateTime @default(now())
}

model ImportInbox {
  id           Int      @id @default(autoincrement())
  source       String   @default("webhook")
  message_text String
  image_url    String?
  skip_reason  String
  parsed_json  Json?
  status       String   @default("pending")
  watch_id     Int?
  created_at   DateTime @default(now())
}

model WatchPayment {
  id             Int           @id @default(autoincrement())
  watch_id       Int
  watch          Watch         @relation(fields: [watch_id], references: [id], onDelete: Cascade)
  amount         Float
  currency       String        @default("USD")
  fx_rate        Float?
  payment_method PaymentMethod @default(CASH)
  payment_date   DateTime      @default(now())
  notes          String?
  created_at     DateTime      @default(now())
}

model WatchTask {
  id           Int            @id @default(autoincrement())
  watch_id     Int
  watch        Watch          @relation(fields: [watch_id], references: [id], onDelete: Cascade)
  department   TaskDepartment
  task_type    String
  phase        String         @default("BUY")
  is_completed Boolean        @default(false)
  completed_at DateTime?
  completed_by String?
  assigned_to  String?
  is_locked    Boolean        @default(false)
  metadata     Json?
  created_at   DateTime       @default(now())
}

model TeamMember {
  id                Int             @id @default(autoincrement())
  name              String
  whatsapp_number   String          @unique
  department        Department      @default(LOGISTICS)
  // Display/grouping team for the Pending page (ACCOUNTING/SALES/GRAPHICS/ADMIN/TRAVEL).
  // Separate from `department`, which drives the watch-task work categories.
  team              String?
  login_username    String?
  password_hash     String?
  role              MemberRole      @default(MEMBER)
  created_at        DateTime        @default(now())
  tasks_assigned_to Task[]          @relation("AssignedTo")
  tasks_assigned_by Task[]          @relation("AssignedBy")
  task_assignments  TaskAssignee[]
  sessions          MemberSession[]
}

model MemberSession {
  token          String     @id
  team_member_id Int
  team_member    TeamMember @relation(fields: [team_member_id], references: [id], onDelete: Cascade)
  expires_at     DateTime
  created_at     DateTime   @default(now())
}

model Task {
  id                        Int            @id @default(autoincrement())
  team_member_id            Int?
  team_member               TeamMember?    @relation("AssignedTo", fields: [team_member_id], references: [id], onDelete: Cascade)
  assigned_team             String?
  assigned_by_id            Int?
  assigned_by               TeamMember?    @relation("AssignedBy", fields: [assigned_by_id], references: [id], onDelete: SetNull)
  message_text              String
  date                      String
  estimated_minutes         Int?
  is_completed              Boolean        @default(false)
  completed_at              DateTime?
  completed_by              String?
  reminder_interval_minutes Int?
  created_at                DateTime       @default(now())
  assignees                 TaskAssignee[]
}

model TaskAssignee {
  id             Int        @id @default(autoincrement())
  task_id        Int
  task           Task       @relation(fields: [task_id], references: [id], onDelete: Cascade)
  team_member_id Int
  team_member    TeamMember @relation(fields: [team_member_id], references: [id], onDelete: Cascade)

  @@unique([task_id, team_member_id])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model TaskTemplate {
  id               Int      @id @default(autoincrement())
  label            String
  department       String
  phase            String   @default("BUY")
  task_type_key    String?
  is_locked        Boolean  @default(false)
  is_builtin       Boolean  @default(false)
  default_assignee String?
  order            Int      @default(0)
  created_at       DateTime @default(now())
}
